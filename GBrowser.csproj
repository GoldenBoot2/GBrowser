<Project Sdk="Microsoft.NET.Sdk">

  <!-- GBrowser by GoldenBoot: a light Windows browser on Microsoft Edge WebView2.
       .NET Framework 4.8 (part of Windows 10/11), so users install no runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>GBrowser</RootNamespace>
    <AssemblyName>GBrowser</AssemblyName>
    <ApplicationIcon>assets\gbrowser.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.2</Version>
    <FileVersion>0.1.2.0</FileVersion>
    <Company>GoldenBoot</Company>
    <Product>GBrowser</Product>
    <Authors>GoldenBoot</Authors>
    <Copyright>Copyright (c) 2026 GoldenBoot</Copyright>
    <AssemblyTitle>GBrowser</AssemblyTitle>
    <Description>GBrowser - light web browser by GoldenBoot</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <WebView2LoaderPreference>Static</WebView2LoaderPreference>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- helper programs under tools/ have their own projects -->
    <Compile Remove="tools/**" />
    <Compile Remove="installer/**" />
    <EmbeddedResource Remove="installer/**" />
    <None Remove="installer/**" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <None Include="pages\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="pages" />
    <None Include="assets\gbrowser.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\gbab.js;assets\extcss.js" CopyToOutputDirectory="PreserveNewest" />
    <!-- compiled filter lists (tools/build_filters.py) -->
    <None Include="filters\*" CopyToOutputDirectory="PreserveNewest" LinkBase="filters" />
  </ItemGroup>

</Project>
